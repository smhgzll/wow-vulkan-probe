#version 450
#extension GL_GOOGLE_include_directive : require
// Sun disc finder: the previous frame's picture (a quarter-resolution copy made at its composite) and its view depth.
// Sky pixels (no world depth) are counted with their quarter-resolution position (sums of x, y, x^2, y^2) in two sets:
// near-white and bright (the midday / Teldrassil disc), and warm - the two strongest channels saturated, the weakest at least
// .55 (a yellow morning / evening sun, e.g. 255/255/190 in Booty Bay at 8:22, which the white test rejected while the hazy
// sky around it is darker in green and blue). The host prefers a compact white cluster, else a compact warm one, and turns
// it into the direction of the disc the game draws - the rays then come from what is seen.
// With the game light read, only texels within a narrow band around the vertical half-plane of its azimuth count (WoW's disc
// is on that arc) and none near the horizon: in a bright yellow midday sky (Booty Bay 9:00) the whole-sky clusters were
// haze, glints along the horizon and clouds, and the fog sun jumped between them.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "fog_common.glsl"
layout(set = 0, binding = 5) uniform sampler2D shadowDepth;
layout(set = 0, binding = 11, rgba8) uniform readonly image2D sceneSmall;
// 16 words per compute slot (memoryC.z = this submission's slot): white set (count, sum x, sum y, sum x^2, sum y^2), sky
// texels, -, -, warm set (count, sum x, sum y, sum x^2, sum y^2), -, -, -
layout(set = 0, binding = 12, std430) buffer SunFind { uint v[]; } found;
void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy), size = imageSize(sceneSmall);
    if (any(greaterThanEqual(t, size))) return;
    ivec2 full = clamp(t * 4 + 2, ivec2(0), ivec2(fog.shadowImage.xy) - 1);
    if (abs(texelFetch(shadowDepth, full, 0).r) < 1e5) return;   // world geometry or water, not sky
    uint b = uint(fog.memoryC.z) * fogReadbackWords;
    if (fog.sunArc.z > 0.0) {
        // This texel's view direction, exactly as the host turns the centroid into one (the searched picture's camera).
        vec2 p = (vec2(t) + .5) * 4.0;
        vec2 n = (p - fog.shadowViewport.xy) / fog.shadowViewport.zw * 2.0 - 1.0;
        vec3 d = normalize(fog.shadowRight.xyz * (n.x / fog.shadowRight.w) + fog.shadowUp.xyz * (n.y / fog.shadowUp.w) + fog.shadowForward.xyz);
        vec2 a = fog.sunArc.xy;
        if (abs(dot(d.xy, vec2(-a.y, a.x))) > fog.sunArc.z || dot(d.xy, a) <= 0.0 || d.z < fog.sunArc.w) return;
    }
    atomicAdd(found.v[b + 5u], 1u);
    vec3 c = imageLoad(sceneSmall, t).rgb;
    float lo = min(c.r, min(c.g, c.b)), hi = max(c.r, max(c.g, c.b)), mid = c.r + c.g + c.b - lo - hi;
    uint set = lo >= .86 && hi >= .93 ? 0u : mid >= .975 && lo >= .55 ? 8u : 16u;
    if (set == 16u) return;
    atomicAdd(found.v[b + set], 1u);
    atomicAdd(found.v[b + set + 1u], uint(t.x)); atomicAdd(found.v[b + set + 2u], uint(t.y));
    atomicAdd(found.v[b + set + 3u], uint(t.x * t.x)); atomicAdd(found.v[b + set + 4u], uint(t.y * t.y));
}
