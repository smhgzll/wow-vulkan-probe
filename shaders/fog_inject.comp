#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 1: medium per froxel centre - rgb = scattering sigma_s (albedo * sigma_t), a = extinction sigma_t.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "fog_common.glsl"
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D medium;
layout(set = 0, binding = 14) uniform sampler3D noiseLattice;   // fog_noise_bake.comp: rgb warp lattices, a octave lattice

// Smooth value noise from the baked lattice: the hardware's trilinear filter at i + smoothstep(fract) (+ .5 texel centre)
// is exactly the smoothstep-interpolated value noise of the four lattices, in one fetch (was 8 hashes per lattice).
const float fogNoiseCells = 64.0;   // fog::noiseLatticeCells
vec4 fogLattice(vec3 p) {
    vec3 i = floor(p), f = fract(p);
    return textureLod(noiseLattice, (i + f * f * (3.0 - 2.0 * f) + .5) / fogNoiseCells, 0.0);
}
// Smoke: density multiplier with mean ~1. Domain-warped fBm (5 octaves, lattice s, s/2 .. s/16; the lattice texture tiles
// every 64 cells, so the field tiles with the origin reduction modulo fog::noise_period = 2 * s * 64 yards), normalised to
// unit variance (z ~ N(0,1)) and shaped by COVERAGE: fog gathers into clumps (z above a threshold that rises with the
// amount) with clear air between, the clumps scaled by 1 / mean coverage so the average density stays. Amount .8: ~60%
// clear air, clumps ~4x. A +-% wobble instead of coverage averages out along the ray and was invisible in the game.
// Octaves finer than the froxel footprint (yards) are faded out so distant fog does not shimmer; the variance is
// renormalised over the octaves that remain, so the smoke has the same contrast near and far. The finer octaves drift by
// noiseDetail on top of the wind: the smoke billows instead of sliding as one rigid pattern. Each octave is shifted by a
// fraction of a cell so the octaves of the one lattice never line up.
float fogNoiseFactor(vec3 world, float footprint) {
    if (fog.noise.x <= 0.0) return 1.0;
    const float valueNoiseSigma = .185;   // std of the smoothstep value noise of uniform lattice values (measured; mean .5)
    float s = fog.noise.y;
    vec3 warp = fogLattice(world / (2.0 * s)).rgb - .5;
    vec3 q = world / s + warp * 1.6;
    vec3 detail = fog.noiseDetail.xyz / s;
    float sum = 0.0, variance = 0.0, amplitude = 1.0, lattice = s;
    for (int k = 0; k < 5; ++k) {
        float weight = amplitude * clamp(lattice / max(footprint, 1e-3) - 1.0, 0.0, 1.0);
        if (weight > 0.0) {
            vec3 p = (k == 0 ? q : q + detail) * float(1 << k) + float(k) * vec3(.37, .71, .53);
            sum += weight * (fogLattice(p).a - .5);
            variance += weight * weight;
        }
        amplitude *= .5; lattice *= .5;
    }
    if (variance <= 1e-6) return 1.0;   // every octave finer than the froxels: homogeneous
    float z = sum / (sqrt(variance) * valueNoiseSigma);
    float shaped = smoothstep(fog.noise.z - .7, fog.noise.z + .7, z) * fog.noise.w;
    return mix(1.0, shaped, min(fog.noise.x * 2.5, 1.0));
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, uvec3(fog.grid.xyz)))) return;
    vec3 uvt = (vec3(id) + fog.jitter.xyz) / fog.grid.xyz;   // jittered inside the froxel (centre when temporal is off)
    float z = fogDepthOfSlice(uvt.z);
    vec3 offset = fogWorldOffset(fogViewRay(uvt.xy * 2.0 - 1.0) * z);
    float sigmaT = min(fogExtinction(fog.right.w + offset.z) * fogNoiseFactor(fog.noiseOrigin.xyz + offset, fogFootprint(z)), fog.medium.w);
    imageStore(medium, ivec3(id), vec4(fog.albedo.rgb * sigmaT, sigmaT));
}
